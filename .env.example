# Supabase - À configurer avec tes vraies valeurs
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Côté serveur uniquement : route iCal publique, cron des rappels, et pages
# publiques de liens d'écoute (bypass RLS + secret HMAC des cookies d'accès).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (canonical, sitemap, liens des emails de rappel).
NEXT_PUBLIC_SITE_URL=

# OAuth Gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth Outlook / Microsoft Graph
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Brevo — envois transactionnels (notification d'inscription, rappels de
# démarches). Sans BREVO_API_KEY, les envois sont ignorés silencieusement :
# pense à la renseigner en production.
BREVO_API_KEY=
BREVO_FROM=
SIGNUP_NOTIFY_TO=
SIGNUP_NOTIFY_FROM=

# Secret du cron Vercel (rappels de démarches). Sans lui, /api/cron/reminders
# refuse de s'exécuter — la route serait sinon déclenchable par n'importe qui.
CRON_SECRET=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Stockage audio du catalogue Phono. Défauts alignés sur le plan Supabase Free
# (50 Mo par fichier, 1 Go par utilisateur) : un master WAV 24 bits est refusé.
# Passer à 200 / 20 le jour du basculement en Supabase Pro — voir ALPHA.md.
NEXT_PUBLIC_MAX_AUDIO_MB=50
NEXT_PUBLIC_STORAGE_QUOTA_GB=1
