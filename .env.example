
# Optionnel : webhook pour synchroniser la waitlist vers Google Sheets / Make / Zapier.
# POST JSON { lastName, firstName, email, status, action, source, submittedAt }
WAITLIST_WEBHOOK_URL=

# Supabase - À configurer avec tes vraies valeurs
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Utilisée côté serveur pour la route iCal publique et la persistance de la waitlist.
SUPABASE_SERVICE_ROLE_KEY=...

# OAuth Gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth Outlook / Microsoft Graph
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

ANTHROPIC_API_KEY=